# naruprof-eclipseDitto local configuration (TEST-ONLY values). The integrated launcher (Kong agent)
# generates per-launch secrets and injects them; never commit real credentials.
NARUPROF_PROFILE_ID=f7933216-20db-49cb-90e0-3a9d5396966d
TWIN_PORT=8083
TWIN_BIND_ADDRESS=127.0.0.1
TWIN_DATA_DIR=./data
VERTX_TO_TWIN_TOKEN=test-only-vertx-to-twin-token-0001
TWIN_MAINTENANCE_TOKEN=test-only-twin-maintenance-token-01
NARU_GRPC_TARGET=127.0.0.1:9092
TWIN_TO_NARU_TOKEN=test-only-twin-to-naru-token-00001
DITTO_API_BASE=http://127.0.0.1:8090/api/2
TWIN_DITTO_SUBJECT_ISSUER=nginx
TWIN_DITTO_OPERATOR_USER=naruprof-twin-operator
TWIN_DITTO_OPERATOR_PASSWORD=test-only-operator-secret
TWIN_DITTO_PROJECTOR_USER=naruprof-twin-projector
TWIN_DITTO_PROJECTOR_PASSWORD=test-only-projector-secret
TWIN_DITTO_READER_USER=naruprof-twin-reader
TWIN_DITTO_READER_PASSWORD=test-only-reader-secret
