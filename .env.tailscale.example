# Copy to .env (same folder as docker-compose.yml), edit, then: docker compose up -d
# Find this machine's Tailscale IP with:  tailscale ip -4

# --- what teammates can reach over the tailnet ---------------------------------------
TWIN_PUBLISH_ADDRESS=<THIS_HOST_TS_IP>    # twin facade :8083 only; from `tailscale ip -4` (check it today)
# Fallback when Docker Desktop cannot bind the Tailscale IP: publish on loopback and bridge with
# netsh portproxy (INTEGRATION-DITTO.md): TWIN_PUBLISH_ADDRESS=127.0.0.1 and TWIN_PUBLISH_PORT=18083
# TWIN_PUBLISH_PORT=8083
FAKE_NARU_PUBLISH_ADDRESS=127.0.0.1       # demo overlay only (docker-compose.fake.yml)

# --- shared with the team (agree on these values together) ----------------------------
NARUPROF_PROFILE_ID=<UUID installed by NARU>             # same UUID in NARU, Vert.x and the twin
VERTX_TO_TWIN_TOKEN=change-me-vertx-to-twin-token        # agreed with the Vert.x owner, shared privately
TWIN_TO_NARU_TOKEN=change-me-twin-to-naru-token          # agreed with the NARU owner, shared privately
TWIN_MAINTENANCE_TOKEN=change-me-twin-maintenance-token  # owner-only operator credential

# --- the real NARU (REQUIRED: docker-compose.yml has no fake fallback) -----------------
# Blank/loopback/fake-naru values make the twin refuse to start. The fake NARU is only
# available through the explicit overlay docker-compose.fake.yml.
NARU_GRPC_TARGET=<NARU_TS_IP>:9092
