# The vendored contract must stay byte-identical to the shared proto (ContractChecksumTest).
*.proto -text
# Shell scripts and container config must keep LF to run inside Linux containers / bash.
*.sh text eol=lf
deploy/ditto/nginx.conf text eol=lf
deploy/ditto/nginx.htpasswd text eol=lf
*.ps1 text eol=crlf
